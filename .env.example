# =====================================
# AUTO_RENEW SYSTEM - Environment Variables
# Copy this file to .env and fill in your values
# =====================================

# =================== DATABASE ===================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://garage_admin:YOUR_SECURE_PASSWORD@localhost:5433/garage_master?schema=public&connection_limit=20&pool_timeout=30

# Database credentials (used by docker-compose)
POSTGRES_USER=garage_admin
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=garage_master

# Connection pool settings
DATABASE_CONNECTION_LIMIT=20
DATABASE_POOL_TIMEOUT=30

# =================== REDIS ===================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# =================== JWT SECRETS ===================
# MUST be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_characters_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_min_32_characters_here_change_in_production

# =================== CORS ===================
CORS_ORIGIN=http://localhost:3000
CUSTOMER_CORS_ORIGIN=http://localhost:3001
MECHANIC_CORS_ORIGIN=http://localhost:3002

# =================== MINIO (S3-compatible) ===================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=garage_minio
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=garage-files
MINIO_USE_SSL=false

# =================== SERVER ===================
NODE_ENV=development
PORT=8080

# =================== RATE LIMITING ===================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20

# =================== LOGGING ===================
LOG_LEVEL=info

# =================== SECURITY ===================
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# =================== FEATURE FLAGS ===================
ENABLE_AUDIT_LOG=true
ENABLE_QUERY_LOGGING=false
ENABLE_CACHE=true
CACHE_TTL=300
