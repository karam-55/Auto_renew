# Database
DATABASE_URL="postgresql://garage_admin:garage_secure_password_2024@localhost:5433/garage_master?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO (File Storage)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="garage-files"
MINIO_USE_SSL="false"

# JWT
JWT_SECRET="your_jwt_secret_min_32_chars"
JWT_REFRESH_SECRET="your_refresh_secret_min_32_chars"

# Server
PORT=8080
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"
CUSTOMER_CORS_ORIGIN="http://localhost:3001"
MECHANIC_CORS_ORIGIN="http://localhost:3002"

# WhatsApp (Optional)
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""

# Firebase Cloud Messaging (Push Notifications)
FCM_PROJECT_ID=""
FCM_PRIVATE_KEY=""

# Multi-tenancy
DEFAULT_TENANT_ID="default"
