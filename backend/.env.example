# Database
DATABASE_URL="postgresql://garage_admin:garage_secure_password_2024@localhost:5433/garage_master?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO (File Storage)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="garage-files"
MINIO_USE_SSL="false"

# JWT
JWT_SECRET="your_jwt_secret_min_32_chars"
JWT_REFRESH_SECRET="your_refresh_secret_min_32_chars"

# Server
PORT=8080
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"
CUSTOMER_CORS_ORIGIN="http://localhost:3001"
MECHANIC_CORS_ORIGIN="http://localhost:3002"

# WhatsApp (Optional)
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_URL=""

# Meta WhatsApp Business API (Direct Meta Graph API)
META_WHATSAPP_ENABLED="false"
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_WHATSAPP_API_VERSION="v18.0"

# WhatChimp WhatsApp API (BSP - recommended for template messages)
WHATCHIMP_ENABLED="true"
WHATCHIMP_API_KEY=""
WHATCHIMP_PHONE_NUMBER_ID=""
WHATCHIMP_BOT_FLOW_WELCOME=""
WHATCHIMP_BOT_FLOW_BOOKING_CONFIRMATION=""
WHATCHIMP_BOT_FLOW_BOOKING_STATUS_UPDATE=""
WHATCHIMP_BOT_FLOW_INVOICE_NEW=""
WHATCHIMP_BOT_FLOW_PAYMENT_RECEIVED=""
WHATCHIMP_BOT_FLOW_WARRANTY_NEW=""

# Firebase Cloud Messaging (Push Notifications)
FCM_PROJECT_ID=""
FCM_PRIVATE_KEY=""

# Multi-tenancy
DEFAULT_TENANT_ID="default"
