# Watchimp WhatsApp API Configuration
# ⚠️ Keep these values secret - never commit to GitHub

# Required for sending messages
WATCHIMP_ENABLED=true
WATCHIMP_API_KEY=your_watchimp_api_key_here
WATCHIMP_API_URL=https://app.whatchimp.com/api/v1
WATCHIMP_PHONE_NUMBER_ID=1150123448190988

# Optional - only needed for initial account connection
# WATCHIMP_USER_ID=your_watchimp_user_id_here
# WATCHIMP_BUSINESS_ACCOUNT_ID=1995628294419623
# WATCHIMP_ACCESS_TOKEN=your_meta_access_token_here
# WATCHIMP_APP_ID=1359195136123999

# Server Public URL (for PDF links in WhatsApp messages)
BASE_URL=https://your-domain.com
