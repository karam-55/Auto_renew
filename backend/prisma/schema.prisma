  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerMemberships CustomerMembership[]
  deletedAt           DateTime?

  @@index([tenantId])
  @@index([isActive])
}

model CustomerMembership {
  id               String           @id @default(uuid())
  tenantId         String
  branchId         String?
  customerId       String
  membershipPlanId String
  startDate        DateTime
  endDate          DateTime
  remainingVisits  Int?
  status           MembershipStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  membershipPlan   MembershipPlan   @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  deletedAt        DateTime?

  @@index([tenantId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([endDate])
}

model LoyaltyPointTransaction {
  id         String                 @id @default(uuid())
  tenantId   String
  customerId String
  points     Int
  type       PointTransactionType
  source     PointTransactionSource
  reference  String?
  createdAt  DateTime               @default(now())
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deletedAt  DateTime?
  updatedAt  DateTime               @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([type])
  @@index([createdAt])
}

model CustomerWallet {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  balance    Decimal   @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([customerId])
  @@index([tenantId])
  @@index([customerId])
}

model Branch {
  id                    String                 @id @default(uuid())
  tenantId              String
  name                  String
  nameAr                String?
  nameEn                String?
  address               String?
  phone                 String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses            Warehouse[]
  employees             Employee[]
  employeeBranches      EmployeeBranch[]
  bookings              Booking[]
  invoices              Invoice[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders        PurchaseOrder[]
  schedules             TechnicianSchedule[]
  customerMemberships   CustomerMembership[]
  inventoryTransfers    InventoryTransfer[]
  auditLogs             AuditLog[]
  deletedAt             DateTime?

  @@index([tenantId])
  @@index([isActive])
}

enum TransferStatus {
  REQUESTED
  APPROVED
  SHIPPED
  RECEIVED
  CANCELLED
}

model InventoryTransfer {
  id              String                  @id @default(uuid())
  tenantId        String
  branchId        String
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus          @default(REQUESTED)
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  fromWarehouse   Warehouse               @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse               @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  items           InventoryTransferItem[]
  deletedAt       DateTime?

  @@index([tenantId])
  @@index([branchId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
}

model InventoryTransferItem {
  id         String            @id @default(uuid())
  tenantId   String
  transferId String
  partId     String
  quantity   Int
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer   InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  part       Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  deletedAt  DateTime?
  updatedAt  DateTime          @updatedAt

  @@index([tenantId])
  @@index([transferId])
  @@index([partId])
}

model TechnicianSchedule {
  id           String         @id @default(uuid())
  tenantId     String
  branchId     String?
  technicianId String
  bookingId    String?
  serviceId    String?
  startTime    DateTime
  endTime      DateTime
  status       ScheduleStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  technician   Employee       @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  booking      Booking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service      Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?        @relation(fields: [branchId], references: [id])
  deletedAt    DateTime?

  @@index([tenantId])
  @@index([branchId])
  @@index([technicianId])
  @@index([bookingId])
  @@index([serviceId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([technicianId, startTime, endTime])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   Employee[]
  permissions RolePermission[]
  deletedAt   DateTime?

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
  deletedAt   DateTime?

  @@index([key])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  deletedAt  DateTime?
  updatedAt  DateTime   @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Dealer {
  id          String          @id @default(uuid())
  tenantId    String
  name        String
  phone       String          @unique
  password    String?
  companyName String
  address     String?
  city        String?
  taxId       String?
  notes       String?
  status      DealerStatus    @default(ACTIVE)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warranties  DealerWarranty[]
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([status])
  @@index([isActive])
}

model DealerWarranty {
  id              String   @id @default(uuid())
  tenantId        String
  dealerId        String
  customerName    String
  customerPhone   String
  manufacturer    String
  vehicleModel    String
  vehicleYear     Int
  chassisNumber   String
  plateNumber     String
  mileage         Int
  color           String
  durationMonths  Int
  amountPaid      Decimal  @db.Decimal(12, 2)
  currency        String   @default("SYP") // SYP or USD
  startDate       DateTime @default(now())
  endDate         DateTime
  pdfUrl          String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  dealer          Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedAt       DateTime?

  @@index([tenantId])
  @@index([dealerId])
  @@index([customerPhone])
  @@index([isActive])
}

model Document {
  id          String          @id @default(uuid())
  tenantId    String
  fileName    String
  fileType    String
  fileSize    String
  filePath    String
  category    DocumentCategory @default(OTHER)
  entityType  String?
  entityId    String?
  description String?
  uploadedBy  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([category])
  @@index([entityType, entityId])
}

enum DealerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DocumentCategory {
  INVOICE
  CONTRACT
  PURCHASE_ORDER
  IMAGE
  REPORT
  OTHER
}

enum CostCenterType {
  WORKSHOP
  WAREHOUSE
  CAR_WASH
  RECEPTION
  ADMIN
  SHARED
}

enum CostDriver {
  LABOR_HOURS
  MATERIAL_MOVES
  SERVICE_COUNT
  INVOICE_COUNT
  FIXED
  REVENUE_ALLOCATION
}

enum CostType {
  DIRECT_LABOR
  DIRECT_MATERIAL
  VARIABLE_OVERHEAD
  FIXED_OVERHEAD
  DEPRECIATION
  ALLOCATED_ADMIN
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  UNITS_OF_PRODUCTION
}

model CostCenter {
  id              String         @id @default(uuid())
  tenantId        String
  name            String
  nameAr          String?
  code            String?
  type            CostCenterType
  costDriver      CostDriver
  driverQuantity  Int            @default(1)
  monthlyBudget   Decimal        @db.Decimal(12, 2)
  actualCost      Decimal?       @db.Decimal(12, 2)
  isActive        Boolean        @default(true)
  isDefault       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  allocationsFrom CostCenterAllocation[] @relation("FromCenter")
  allocationsTo   CostCenterAllocation[] @relation("ToCenter")
  serviceCosts    ServiceCostDetail[]
  jobCosts        BookingJobCost[]

  @@index([tenantId])
  @@index([type])
  @@index([isActive])
}

model CostCenterAllocation {
  id                String   @id @default(uuid())
  tenantId          String
  fromCenterId      String
  toCenterId        String
  allocationPercent Decimal  @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  fromCenter CostCenter @relation("FromCenter", fields: [fromCenterId], references: [id], onDelete: Cascade)
  toCenter   CostCenter @relation("ToCenter", fields: [toCenterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fromCenterId])
  @@index([toCenterId])
}

model AssetCategory {
  id                 String    @id @default(uuid())
  tenantId           String
  name               String
  description        String?
  depreciationMethod String    @default("STRAIGHT_LINE")
  usefulLifeYears    Int       @default(5)
  salvageValuePercent Decimal  @default(10.00) @db.Decimal(5, 2)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assets Asset[]

  @@index([tenantId])
}

model Asset {
  id                       String              @id @default(uuid())
  tenantId                 String
  categoryId               String
  name                     String
  description              String?
  purchaseCost             Decimal             @db.Decimal(12, 2)
  purchaseDate             DateTime
  salvageValue             Decimal             @db.Decimal(12, 2) @default(0)
  monthlyDepreciation      Decimal?            @db.Decimal(12, 2)
  userAdjustedDepreciation Decimal?            @db.Decimal(12, 2)
  accumulatedDepreciation  Decimal?            @db.Decimal(12, 2)
  isActive                 Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  category     AssetCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceCosts ServiceCostDetail[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([isActive])
}

model ServiceCostDetail {
  id           String     @id @default(uuid())
  tenantId     String
  serviceId    String
  costCenterId String?
  assetId      String?
  costType     CostType
  amountSYP    Decimal    @db.Decimal(12, 2)
  amountUSD    Decimal?   @db.Decimal(12, 2)
  isCalculated Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  asset      Asset?      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([serviceId])
  @@index([costCenterId])
  @@index([assetId])
}

model BookingJobCost {
  id            String    @id @default(uuid())
  tenantId      String
  bookingId     String
  mechanicId    String?
  serviceId     String
  costCenterId  String?
  laborHours    Decimal?  @db.Decimal(5, 2)
  laborCost     Decimal?  @db.Decimal(12, 2)
  materialCost  Decimal?  @db.Decimal(12, 2)
  overheadCost  Decimal?  @db.Decimal(12, 2)
  totalCost     Decimal?  @db.Decimal(12, 2)
  varianceNote  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([bookingId])
  @@index([serviceId])
}
