generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                       String                    @id @default(uuid())
  name                     String
  nameAr                   String?
  nameEn                   String?
  domain                   String?                   @unique
  logoUrl                  String?
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  accounts                 Account[]
  bookings                 Booking[]
  companySettings          CompanySettings?
  customers                Customer[]
  dealers                  Dealer[]
  dealerWarranties         DealerWarranty[]
  departments              Department[]
  documents                Document[]
  employees                Employee[]
  invoices                 Invoice[]
  journalEntries           JournalEntry[]
  suppliers                Supplier[]
  users                    User[]
  Vehicle                  Vehicle[]
  vehicleCategories        VehicleCategory[]
  serviceCategories        ServiceCategory[]
  warehouses               Warehouse[]
  schedules                TechnicianSchedule[]
  membershipPlans          MembershipPlan[]
  customerMemberships      CustomerMembership[]
  loyaltyPointTransactions LoyaltyPointTransaction[]
  customerWallets          CustomerWallet[]
  branches                 Branch[]
  inventoryTransfers       InventoryTransfer[]
  roles                    Role[]
  auditLogs                AuditLog[]
  exchangeRates            ExchangeRate[]
  grnLines                 GoodsReceiptNoteLine[]
  purchaseOrderItems       PurchaseOrderItem[]
  maintenancePackageItems  MaintenancePackageItem[]
  inventoryCountItems      InventoryCountItem[]
  inventoryTransferItems   InventoryTransferItem[]
  deletedAt                DateTime?
}

model User {
  id                      String                  @id @default(uuid())
  tenantId                String
  fullName                String
  username                String
  passwordHash            String
  phone                   String
  role                    UserRole
  isActive                Boolean                 @default(true)
  failedLoginAttempts     Int                     @default(0)
  lockedUntil             DateTime?
  telegramChatId          String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  auditLogs               AuditLog[]
  cashRegister            CashRegister?
  cashRegisterSessions    CashRegisterSession[]   @relation("CashRegisterSessionCashier")
  employee                Employee?
  approvedJournalEntries  JournalEntry[]          @relation("JournalEntryApprover")
  createdJournalEntries   JournalEntry[]          @relation("JournalEntryCreator")
  mechanicAssignments     MechanicAssignment[]    @relation("MechanicAssignments")
  partSuggestions         PartSuggestion[]
  pushNotificationTokens  PushNotificationToken[]
  taskAssignments         TaskAssignment[]
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  managedWarehouses       Warehouse[]             @relation("WarehouseManager")
  countedInventoryCounts  InventoryCount[]        @relation("InventoryCountCounter")
  approvedInventoryCounts InventoryCount[]        @relation("InventoryCountApprover")
  deletedAt               DateTime?

  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([role])
}

model Customer {
  id                       String                    @id @default(uuid())
  tenantId                 String
  fullName                 String
  phone                    String
  address                  String?
  notes                    String?
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  city                     String?
  isVip                    Boolean                   @default(false)
  loyaltyPoints            Int                       @default(0)
  bookings                 Booking[]
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices                 Invoice[]
  vehicles                 Vehicle[]
  customerMemberships      CustomerMembership[]
  loyaltyPointTransactions LoyaltyPointTransaction[]
  customerWallet           CustomerWallet?
  deletedAt                DateTime?

  @@index([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
  @@index([fullName])
}

model LoyaltyPoint {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  points     Int       @default(0)
  invoiceId  String?
  reason     String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
}

model LoyaltyReward {
  id             String     @id @default(uuid())
  tenantId       String
  name           String
  nameAr         String?
  nameEn         String?
  description    String?
  pointsRequired Int
  discountType   RewardType
  discountValue  Decimal    @db.Decimal(12, 2)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@index([tenantId])
  @@index([pointsRequired])
}

model VehicleCategory {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  nameAr      String
  nameEn      String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  vehicles    Vehicle[]
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?

  @@index([tenantId])
}

model Vehicle {
  id                        String                       @id @default(uuid())
  tenantId                  String
  customerId                String
  categoryId                String?
  make                      String
  model                     String
  year                      Int
  licensePlate              String
  vin                       String?
  publicCarId               String                       @unique
  currentKm                 Int?
  lastServiceDate           DateTime?
  nextServiceDate           DateTime?
  notes                     String?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  color                     String?
  attachments               Attachment[]
  bookings                  Booking[]
  invoices                  Invoice[]
  preventiveMaintenanceLogs PreventiveMaintenanceLog[]
  customer                  Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tenant                    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category                  VehicleCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inspectionChecklists      VehicleInspectionChecklist[]
  issues                    VehicleIssue[]
  mileageLogs               VehicleMileageLog[]
  histories                 VehicleHistory[]
  faults                    VehicleFault[]
  vehicleAttachments        VehicleAttachment[]
  recommendations           VehicleRecommendation[]
  deletedAt                 DateTime?

  @@unique([tenantId, licensePlate])
  @@index([tenantId])
  @@index([customerId])
  @@index([categoryId])
  @@index([publicCarId])
  @@index([licensePlate])
}

enum VehicleHistoryType {
  SERVICE
  PART_CONSUMPTION
  FAULT
  NOTE
}

model VehicleHistory {
  id           String             @id @default(uuid())
  tenantId     String
  vehicleId    String
  invoiceId    String?
  serviceId    String?
  technicianId String?
  description  String
  type         VehicleHistoryType
  createdAt    DateTime           @default(now())
  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deletedAt    DateTime?
  updatedAt    DateTime           @updatedAt

  @@index([tenantId])
  @@index([vehicleId])
  @@index([type])
  @@index([createdAt])
}

enum FaultSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FaultStatus {
  OPEN
  RESOLVED
}

model VehicleFault {
  id          String        @id @default(uuid())
  tenantId    String
  vehicleId   String
  title       String
  description String
  severity    FaultSeverity
  status      FaultStatus   @default(OPEN)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@index([vehicleId])
  @@index([status])
  @@index([severity])
}

enum AttachmentType {
  IMAGE
  DOCUMENT
}

model VehicleAttachment {
  id          String         @id @default(uuid())
  tenantId    String
  vehicleId   String
  fileUrl     String
  type        AttachmentType
  name        String?
  description String?
  uploadedBy  String?
  createdAt   DateTime       @default(now())
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?
  updatedAt   DateTime       @updatedAt

  @@index([tenantId])
  @@index([vehicleId])
  @@index([type])
}

enum RecommendationStatus {
  PENDING
  DONE
}

model VehicleRecommendation {
  id          String               @id @default(uuid())
  tenantId    String
  vehicleId   String
  title       String
  description String
  dueMileage  Int?
  dueDate     DateTime?
  status      RecommendationStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  vehicle     Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?
  updatedAt   DateTime             @updatedAt

  @@index([tenantId])
  @@index([vehicleId])
  @@index([status])
  @@index([dueDate])
}

model ServiceCategory {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  nameAr      String
  nameEn      String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?

  @@index([tenantId])
}

model Service {
  id                       String                   @id @default(uuid())
  tenantId                 String
  categoryId               String?
  name                     String
  nameAr                   String?
  nameEn                   String?
  description              String?
  priceSYP                 Decimal                  @db.Decimal(12, 2)
  priceUSD                 Decimal?                 @db.Decimal(12, 2)
  estimatedDurationMinutes Int?
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  basePrice                Decimal?                 @db.Decimal(12, 2)
  laborCostSYP             Decimal?                 @db.Decimal(12, 2)
  laborCostUSD             Decimal?                 @db.Decimal(12, 2)
  materialCostSYP          Decimal?                 @db.Decimal(12, 2)
  materialCostUSD          Decimal?                 @db.Decimal(12, 2)
  profitAmountSYP          Decimal?                 @db.Decimal(12, 2)
  profitAmountUSD          Decimal?                 @db.Decimal(12, 2)
  profitType               String?                  @default("percentage")
  profitMargin             Decimal?                 @db.Decimal(5, 2)
  hasWarranty              Boolean                  @default(false)
  warrantyDescription      String?
  warrantyTerms            String?
  loyaltyPoints            Int                      @default(0)
  duration                 Int?
  bookingServices          BookingService[]         @relation("BookingServices")
  invoiceItems             InvoiceItem[]            @relation("InvoiceItems")
  maintenancePackageItems  MaintenancePackageItem[]
  serviceParts             ServicePart[]
  schedules                TechnicianSchedule[]
  category                 ServiceCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  department               Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  deletedAt                DateTime?
  serviceCosts             ServiceCostDetail[]
  departmentId             String?
  assignedEmployeeId       String?

  @@index([tenantId])
  @@index([categoryId])
  @@index([departmentId])
}

model ServicePart {
  id        String    @id @default(uuid())
  serviceId String
  partId    String
  quantity  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  deletedAt DateTime?

  @@unique([serviceId, partId])
  @@index([serviceId])
  @@index([partId])
}

model Booking {
  id                      String               @id @default(uuid())
  tenantId                String
  branchId                String?
  customerId              String
  vehicleId               String
  status                  BookingStatus        @default(PENDING)
  publicToken             String               @unique
  notes                   String?
  estimatedCompletionDate DateTime?
  actualCompletionDate    DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  priority                String?
  paymentMethod           BookingPaymentMethod     @default(CASH)
  scheduledDate           DateTime
  scheduledTime           String?
  appointmentLog          AppointmentLog?
  attachments             Attachment[]
  customer                Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                  Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicle                 Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookingExtraCharges     BookingExtraCharge[]
  bookingServices         BookingService[]     @relation("BookingServices")
  electronicSignature     ElectronicSignature?
  invoices                Invoice[]
  mechanicAssignments     MechanicAssignment[]
  partSuggestions         PartSuggestion[]
  reviews                 Review[]
  tasks                   Task[]
  schedules               TechnicianSchedule[]
  deletedAt               DateTime?

  @@index([tenantId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status, createdAt])
  @@index([scheduledDate])
}

model BookingService {
  id        String    @id @default(uuid())
  bookingId String
  serviceId String
  priceSYP  Decimal   @db.Decimal(12, 2)
  priceUSD  Decimal?  @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime  @default(now())
  booking   Booking   @relation("BookingServices", fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service   @relation("BookingServices", fields: [serviceId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@index([serviceId])
}

model MechanicAssignment {
  id             String           @id @default(uuid())
  bookingId      String           @unique
  mechanicUserId String
  status         AssignmentStatus @default(ASSIGNED)
  notes          String?
  assignedAt     DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mechanic       User             @relation("MechanicAssignments", fields: [mechanicUserId], references: [id], onDelete: Cascade)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@index([bookingId])
  @@index([mechanicUserId])
  @@index([status])
  @@index([bookingId, status])
}

model PartSuggestion {
  id             String           @id @default(uuid())
  bookingId      String
  mechanicUserId String
  type           PartType
  description    String
  priceSYP       Decimal?         @db.Decimal(12, 2)
  priceUSD       Decimal?         @db.Decimal(12, 2)
  status         SuggestionStatus @default(PENDING_CUSTOMER_APPROVAL)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  booking        Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mechanic       User             @relation(fields: [mechanicUserId], references: [id], onDelete: Cascade)
  deletedAt      DateTime?

  @@index([bookingId])
  @@index([mechanicUserId])
  @@index([status])
}

model Supplier {
  id                    String                 @id @default(uuid())
  tenantId              String
  name                  String
  phone                 String
  address               String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  balance               Decimal                @default(0) @db.Decimal(12, 2)
  contactPerson         String?
  contactPhone          String?
  creditLimit           Decimal?               @db.Decimal(12, 2)
  notes                 String?
  paymentTerms          String?
  status                SupplierStatus         @default(ACTIVE)
  taxId                 String?
  isActive              Boolean                @default(true)
  grns                  GoodsReceiptNote[]
  parts                 Part[]
  purchaseOrders        PurchaseOrder[]
  inventoryTransactions InventoryTransaction[]
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedAt             DateTime?

  @@index([tenantId])
  @@index([status])
  @@index([isActive])
}

model PartCategory {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  nameAr      String?
  nameEn      String?
  parentId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  color       String?
  description String?
  icon        String?
  parts       Part[]
  parent      PartCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    PartCategory[] @relation("CategoryHierarchy")
  deletedAt   DateTime?

  @@index([tenantId])
}

model Part {
  id                      String                   @id @default(uuid())
  tenantId                String
  partNumber              String                   @unique
  name                    String
  nameAr                  String?
  nameEn                  String?
  categoryId              String?
  supplierId              String?
  description             String?
  costSYP                 Decimal                  @db.Decimal(12, 2)
  costUSD                 Decimal?                 @db.Decimal(12, 2)
  sellingPriceSYP         Decimal                  @db.Decimal(12, 2)
  sellingPriceUSD         Decimal?                 @db.Decimal(12, 2)
  quantity                Int                      @default(0)
  minQuantity             Int                      @default(5)
  location                String?
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  attachments             Attachment[]
  grnLines                GoodsReceiptNoteLine[]
  inventoryCountItems     InventoryCountItem[]
  inventoryTransactions   InventoryTransaction[]
  invoiceItems            InvoiceItem[]
  maintenancePackageItems MaintenancePackageItem[]
  serviceParts            ServicePart[]
  transferItems           InventoryTransferItem[]
  category                PartCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier                Supplier?                @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrderItems      PurchaseOrderItem[]
  deletedAt               DateTime?

  @@index([tenantId])
  @@index([partNumber])
  @@index([categoryId])
  @@index([name])
}

model Warehouse {
  id                    String                 @id @default(uuid())
  tenantId              String
  branchId              String?
  name                  String
  isPrimary             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  address               String?
  capacity              Int?
  code                  String
  managerId             String?
  phone                 String
  status                WarehouseStatus        @default(ACTIVE)
  grns                  GoodsReceiptNote[]
  inventoryTransactions InventoryTransaction[]
  inventoryCounts       InventoryCount[]
  fromTransfers         InventoryTransfer[]    @relation("FromWarehouse")
  toTransfers           InventoryTransfer[]    @relation("ToWarehouse")
  manager               User?                  @relation("WarehouseManager", fields: [managerId], references: [id])
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  deletedAt             DateTime?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
  @@index([managerId])
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  tenantId    String
  branchId    String?
  partId      String
  warehouseId String?
  supplierId  String?
  type        TransactionType
  quantity    Int
  costSYP     Decimal         @db.Decimal(12, 2)
  costUSD     Decimal?        @db.Decimal(12, 2)
  reference   String?
  notes       String?
  invoiceId   String?
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  part        Part            @relation(fields: [partId], references: [id], onDelete: Cascade)
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  branch      Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier    Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  deletedAt   DateTime?

  @@index([tenantId])
  @@index([branchId])
  @@index([partId])
  @@index([warehouseId])
  @@index([supplierId])
  @@index([type])
  @@index([partId, createdAt])
  @@index([invoiceId])
}

model FiscalPeriod {
  id             String             @id @default(uuid())
  tenantId       String
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  status         FiscalPeriodStatus @default(ACTIVE)
  journalEntries JournalEntry[]
  deletedAt      DateTime?

  @@index([tenantId])
  @@index([startDate])
  @@index([endDate])
}

model Account {
  id           String           @id @default(uuid())
  tenantId     String
  code         String
  nameAr       String
  nameEn       String
  parentId     String?
  accountType  AccountType
  category     AccountCategory?
  isContra     Boolean          @default(false)
  balanceSYP   Decimal          @default(0) @db.Decimal(15, 2)
  balanceUSD   Decimal          @default(0) @db.Decimal(15, 2)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  parent       Account?         @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Account[]        @relation("AccountHierarchy")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  deletedAt    DateTime?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([accountType])
  @@index([category])
}

model JournalEntry {
  id             String             @id @default(uuid())
  tenantId       String
  entryDate      DateTime
  reference      String?
  description    String
  isReversing    Boolean            @default(false)
  reversingDate  DateTime?
  isReversed     Boolean            @default(false)
  fiscalPeriodId String?
  sourceType     String?
  sourceId       String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  status         JournalEntryStatus @default(DRAFT)
  approvedBy     User?              @relation("JournalEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("JournalEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  fiscalPeriod   FiscalPeriod?      @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines          JournalLine[]
  deletedAt      DateTime?

  @@index([tenantId])
  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@index([fiscalPeriodId])
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String
  accountId   String
  accountName String?
  debitSYP    Decimal      @default(0) @db.Decimal(15, 2)
  debitUSD    Decimal      @default(0) @db.Decimal(15, 2)
  creditSYP   Decimal      @default(0) @db.Decimal(15, 2)
  creditUSD   Decimal      @default(0) @db.Decimal(15, 2)
  description String?
  sourceType  String?
  sourceId    String?
  createdAt   DateTime     @default(now())
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  deletedAt   DateTime?
  updatedAt   DateTime     @updatedAt

  @@index([entryId])
  @@index([accountId])
  @@index([sourceType, sourceId])
  @@index([accountId, createdAt])
}

model Invoice {
  id                    String           @id @default(uuid())
  tenantId              String
  branchId              String?
  customerId            String?
  vehicleId             String?
  bookingId             String?
  invoiceNumber         String           @unique
  invoiceDate           DateTime         @default(now())
  dueDate               DateTime?
  subtotalSYP           Decimal          @db.Decimal(12, 2)
  subtotalUSD           Decimal?         @db.Decimal(12, 2)
  taxSYP                Decimal          @default(0) @db.Decimal(12, 2)
  taxUSD                Decimal?         @db.Decimal(12, 2)
  taxRateId             String?
  discountType          DiscountType     @default(FIXED)
  discountPercent       Decimal?         @db.Decimal(5, 2)
  discountSYP           Decimal          @default(0) @db.Decimal(12, 2)
  discountUSD           Decimal?         @db.Decimal(12, 2)
  loyaltyPointsEarned   Int              @default(0)
  loyaltyPointsRedeemed Int              @default(0)
  totalSYP              Decimal          @db.Decimal(12, 2)
  totalUSD              Decimal?         @db.Decimal(12, 2)
  paidSYP               Decimal          @default(0) @db.Decimal(12, 2)
  paidUSD               Decimal          @default(0) @db.Decimal(12, 2)
  status                InvoiceStatus    @default(DRAFT)
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  installmentPlanId     String?
  attachments           Attachment[]
  couponUsages          CouponUsage[]
  booking               Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
