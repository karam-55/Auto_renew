// Prisma Schema for Garage Go 2.0
// Multi-tenancy: Schema per Tenant
//
// ⚠️ IMPORTANT: NO EMAIL FIELDS ALLOWED
// All communication uses Phone, WhatsApp, or In-app notifications
// See NO_EMAILS.md for details

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT & AUTH
// ============================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  nameAr    String?
  nameEn    String?
  domain    String?  @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  customers       Customer[]
  bookings        Booking[]
  invoices        Invoice[]
  accounts        Account[]
  journalEntries  JournalEntry[]
  companySettings CompanySettings?
  Vehicle         Vehicle[]
  suppliers       Supplier[]
  warehouses      Warehouse[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  fullName     String
  username     String
  passwordHash String
  phone        String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mechanicAssignments    MechanicAssignment[]
  partSuggestions        PartSuggestion[]
  auditLogs              AuditLog[]
  createdJournalEntries  JournalEntry[]          @relation("JournalEntryCreator")
  approvedJournalEntries JournalEntry[]          @relation("JournalEntryApprover")
  pushNotificationTokens PushNotificationToken[]
  cashRegister           CashRegister?
  cashRegisterSessions   CashRegisterSession[]   @relation("CashRegisterSessionCashier")
  taskAssignments        TaskAssignment[]
  managedWarehouses      Warehouse[]             @relation("WarehouseManager")

  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([role])
}

enum UserRole {
  OWNER
  MANAGER
  RECEPTIONIST
  ACCOUNTANT
  MECHANIC
  SALES
  CASHIER
}

// ============================================
// CUSTOMERS & VEHICLES
// ============================================

model Customer {
  id            String   @id @default(uuid())
  tenantId      String
  fullName      String
  phone         String
  address       String?
  city          String?
  loyaltyPoints Int      @default(0)
  isVip         Boolean  @default(false)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  bookings Booking[]
  invoices Invoice[]

  @@index([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
}

model Vehicle {
  id           String   @id @default(uuid())
  tenantId     String
  customerId   String
  make         String
  model        String
  year         Int
  licensePlate String
  vin          String?
  color        String?
  publicCarId  String   @unique
  currentKm    Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                  Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings                  Booking[]
  attachments               Attachment[]
  maintenanceSchedules      MaintenanceSchedule[]
  mileageLogs               VehicleMileageLog[]
  issues                    VehicleIssue[]
  inspectionChecklists      VehicleInspectionChecklist[]
  preventiveMaintenanceLogs PreventiveMaintenanceLog[]

  @@index([tenantId])
  @@index([customerId])
  @@index([publicCarId])
}

// ============================================
// SERVICES & BOOKINGS
// ============================================

model Service {
  id                       String   @id @default(uuid())
  tenantId                 String
  name                     String
  nameAr                   String?
  nameEn                   String?
  description              String?
  category                 String?
  priceSYP                 Decimal  @db.Decimal(12, 2)
  priceUSD                 Decimal? @db.Decimal(12, 2)
  duration                 Int?     // in minutes
  basePrice                Decimal? @db.Decimal(12, 2)
  estimatedDurationMinutes Int?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  bookingServices         BookingService[]
  maintenancePackageItems MaintenancePackageItem[]

  @@index([tenantId])
}

model Booking {
  id                      String        @id @default(uuid())
  tenantId                String
  customerId              String
  vehicleId               String
  status                  BookingStatus @default(PENDING)
  publicToken             String        @unique
  scheduledDate           DateTime?
  scheduledTime           String?
  priority                String?
  notes                   String?
  estimatedCompletionDate DateTime?
  actualCompletionDate    DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle             Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookingServices     BookingService[]
  mechanicAssignments MechanicAssignment[]
  partSuggestions     PartSuggestion[]
  invoices            Invoice[]
  attachments         Attachment[]
  electronicSignature ElectronicSignature?
  tasks               Task[]
  reviews             Review[]
  appointmentLog      AppointmentLog?
  bookingExtraCharges BookingExtraCharge[]

  @@index([tenantId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledDate])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  WAITING_PARTS
  READY
  DELIVERED
  CANCELLED
  NO_SHOW
}

model BookingService {
  id        String   @id @default(uuid())
  bookingId String
  serviceId String
  priceSYP  Decimal  @db.Decimal(12, 2)
  priceUSD  Decimal? @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@index([serviceId])
}

model MechanicAssignment {
  id             String           @id @default(uuid())
  tenantId       String
  bookingId      String
  mechanicId     String
  mechanicUserId String
  status         AssignmentStatus @default(ASSIGNED)
  notes          String?
  assignedAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mechanic User    @relation(fields: [mechanicUserId], references: [id], onDelete: Cascade)

  @@unique([bookingId])
  @@index([tenantId])
  @@index([bookingId])
  @@index([mechanicUserId])
  @@index([status])
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  READY
  DELIVERED
}

model PartSuggestion {
  id             String           @id @default(uuid())
  bookingId      String
  mechanicUserId String
  type           PartType
  description    String
  priceSYP       Decimal?         @db.Decimal(12, 2)
  priceUSD       Decimal?         @db.Decimal(12, 2)
  status         SuggestionStatus @default(PENDING_CUSTOMER_APPROVAL)
  c
