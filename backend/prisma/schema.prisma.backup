// Prisma Schema for Garage Go 2.0
// Multi-tenancy: Schema per Tenant
//
// ⚠️ IMPORTANT: NO EMAIL FIELDS ALLOWED
// All communication uses Phone, WhatsApp, or In-app notifications
// See NO_EMAILS.md for details

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT & AUTH
// ============================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  nameAr    String?
  nameEn    String?
  domain    String?  @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  customers       Customer[]
  bookings        Booking[]
  invoices        Invoice[]
  accounts        Account[]
  journalEntries  JournalEntry[]
  companySettings CompanySettings?
  Vehicle         Vehicle[]
  suppliers       Supplier[]
  warehouses      Warehouse[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  fullName     String
  username     String
  passwordHash String
  phone        String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mechanicAssignments    MechanicAssignment[]
  partSuggestions        PartSuggestion[]
  auditLogs              AuditLog[]
  createdJournalEntries  JournalEntry[]          @relation("JournalEntryCreator")
  approvedJournalEntries JournalEntry[]          @relation("JournalEntryApprover")
  pushNotificationTokens PushNotificationToken[]
  cashRegister           CashRegister?
  cashRegisterSessions   CashRegisterSession[]   @relation("CashRegisterSessionCashier")
  taskAssignments        TaskAssignment[]
  managedWarehouses      Warehouse[]             @relation("WarehouseManager")

  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([role])
}

enum UserRole {
  OWNER
  MANAGER
  RECEPTIONIST
  ACCOUNTANT
  MECHANIC
  SALES
  CASHIER
}

// ============================================
// CUSTOMERS & VEHICLES
// ============================================

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  fullName  String
  phone     String
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  bookings Booking[]
  invoices Invoice[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
}

model Vehicle {
  id           String   @id @default(uuid())
  tenantId     String
  customerId   String
  make         String
  model        String
  year         Int
  licensePlate String?
  vin          String?
  publicCarId  String   @unique
  currentKm    Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                  Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings                  Booking[]
  attachments               Attachment[]
  maintenanceSchedules      MaintenanceSchedule[]
  mileageLogs               VehicleMileageLog[]
  issues                    VehicleIssue[]
  inspectionChecklists      VehicleInspectionChecklist[]
  preventiveMaintenanceLogs PreventiveMaintenanceLog[]

  @@index([tenantId])
  @@index([customerId])
  @@index([publicCarId])
}

// ============================================
// SERVICES & BOOKINGS
// ============================================

model Service {
  id                       String   @id @default(uuid())
  tenantId                 String
  name                     String
  nameAr                   String?
  nameEn                   String?
  description              String?
  priceSYP                 Decimal  @db.Decimal(12, 2)
  priceUSD                 Decimal? @db.Decimal(12, 2)
  estimatedDurationMinutes Int?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  bookingServices         BookingService[]
  maintenancePackageItems MaintenancePackageItem[]

  @@index([tenantId])
}

model Booking {
  id                      String        @id @default(uuid())
  tenantId                String
  customerId              String
  vehicleId               String
  status                  BookingStatus @default(PENDING)
  publicToken             String        @unique
  notes                   String?
  estimatedCompletionDate DateTime?
  actualCompletionDate    DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle             Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookingServices     BookingService[]
  mechanicAssignments MechanicAssignment[]
  partSuggestions     PartSuggestion[]
  invoices            Invoice[]
  attachments         Attachment[]
  electronicSignature ElectronicSignature?
  tasks               Task[]
  reviews             Review[]
  appointmentLog      AppointmentLog?
  bookingExtraCharges BookingExtraCharge[]

  @@index([tenantId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
}

enum BookingStatus {
  PENDING
  IN_PROGRESS
  WAITING_PARTS
  READY
  DELIVERED
  CANCELLED
}

model BookingService {
  id        String   @id @default(uuid())
  bookingId String
  serviceId String
  priceSYP  Decimal  @db.Decimal(12, 2)
  priceUSD  Decimal? @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@index([serviceId])
}

model MechanicAssignment {
  id             String           @id @default(uuid())
  bookingId      String
  mechanicUserId String
  status         AssignmentStatus @default(ASSIGNED)
  notes          String?
  assignedAt     DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mechanic User    @relation(fields: [mechanicUserId], references: [id], onDelete: Cascade)

  @@unique([bookingId])
  @@index([bookingId])
  @@index([mechanicUserId])
  @@index([status])
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  READY
  DELIVERED
}

model PartSuggestion {
  id             String           @id @default(uuid())
  bookingId      String
  mechanicUserId String
  type           PartType
  description    String
  priceSYP       Decimal?         @db.Decimal(12, 2)
  priceUSD       Decimal?         @db.Decimal(12, 2)
  status         SuggestionStatus @default(PENDING_CUSTOMER_APPROVAL)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mechanic User    @relation(fields: [mechanicUserId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([mechanicUserId])
  @@index([status])
}

enum PartType {
  ORIGINAL
  COMMERCIAL
  USED
}

enum SuggestionStatus {
  PENDING_CUSTOMER_APPROVAL
  APPROVED
  REJECTED
}

// ============================================
// INVENTORY
// ============================================

model Supplier {
  id             String        @id @default(uuid())
  tenantId       String
  name           String
  phone          String
  address        String?
  contactPerson  String?
  contactPhone   String?
  taxId          String?
  paymentTerms   String?
  creditLimit    Decimal?      @db.Decimal(12, 2)
  balance        Decimal       @default(0) @db.Decimal(12, 2)
  status         SupplierStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parts          Part[]
  purchaseOrders PurchaseOrder[]
  grns          GoodsReceiptNote[]

  @@index([tenantId])
  @@index([status])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model PartCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  nameAr    String?
  nameEn    String?
  description String?
  parentId  String?
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   PartCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children PartCategory[] @relation("CategoryHierarchy")
  parts    Part[]

  @@index([tenantId])
}

model Part {
  id              String   @id @default(uuid())
  tenantId        String
  partNumber      String   @unique
  name            String
  nameAr          String?
  nameEn          String?
  categoryId      String?
  supplierId      String?
  description     String?
  costSYP         Decimal  @db.Decimal(12, 2)
  costUSD         Decimal? @db.Decimal(12, 2)
  sellingPriceSYP Decimal  @db.Decimal(12, 2)
  sellingPriceUSD Decimal? @db.Decimal(12, 2)
  quantity        Int      @default(0)
  minQuantity     Int      @default(5)
  location        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category                PartCategory?            @relation(fields: [categoryId], references: [id])
  supplier                Supplier?                @relation(fields: [supplierId], references: [id])
  inventoryTransactions   InventoryTransaction[]
  purchaseOrderItems      PurchaseOrderItem[]
  invoiceItems            InvoiceItem[]
  attachments             Attachment[]
  maintenancePackageItems MaintenancePackageItem[]
  inventoryCountItems     InventoryCountItem[]
  grnLines                GoodsReceiptNoteLine[]

  @@index([tenantId])
  @@index([partNumber])
  @@index([categoryId])
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Warehouse {
  id        String          @id @default(uuid())
  tenantId  String
  name      String
  code      String
  address   String?
  phone     String
  managerId String?
  capacity  Int?
  status    WarehouseStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager                User?                  @relation("WarehouseManager", fields: [managerId], references: [id])
  inventoryTransactions  InventoryTransaction[]
  grns                   GoodsReceiptNote[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([managerId])
}

model InventoryTransaction {
  id          String          @id @default(uuid())
  tenantId    String
  partId      String
  warehouseId String?
  type        TransactionType
  quantity    Int
  costSYP     Decimal         @db.Decimal(12, 2)
  costUSD     Decimal?        @db.Decimal(12, 2)
  reference   String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  part      Part       @relation(fields: [partId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([partId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
}

enum TransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER
  RETURN
  CONSUMPTION
}

enum OrderStatus {
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

// ============================================
// ACCOUNTING
// ============================================

model FiscalPeriod {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalEntries JournalEntry[]

  @@index([tenantId])
  @@index([startDate])
  @@index([endDate])
}

model Account {
  id          String      @id @default(uuid())
  tenantId    String
  code        String
  nameAr      String
  nameEn      String
  parentId    String?
  accountType AccountType
  balanceSYP  Decimal     @default(0) @db.Decimal(15, 2)
  balanceUSD  Decimal     @default(0) @db.Decimal(15, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountHierarchy")
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([accountType])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model JournalEntry {
  id             String    @id @default(uuid())
  tenantId       String
  entryDate      DateTime
  reference      String?
  description    String
  isReversing    Boolean   @default(false)
  reversingDate  DateTime?
  isReversed     Boolean   @default(false)
  fiscalPeriodId String?
  sourceType     String?
  sourceId       String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalPeriod FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])
  createdBy    User?         @relation("JournalEntryCreator", fields: [createdById], references: [id])
  approvedBy   User?         @relation("JournalEntryApprover", fields: [approvedById], references: [id])
  lines        JournalLine[]

  @@index([tenantId])
  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@index([fiscalPeriodId])
}

model JournalLine {
  id          String   @id @default(uuid())
  entryId     String
  accountId   String
  accountName String?
  debitSYP    Decimal  @default(0) @db.Decimal(15, 2)
  debitUSD    Decimal  @default(0) @db.Decimal(15, 2)
  creditSYP   Decimal  @default(0) @db.Decimal(15, 2)
  creditUSD   Decimal  @default(0) @db.Decimal(15, 2)
  description String?
  sourceType  String?
  sourceId    String?
  createdAt   DateTime @default(now())

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([sourceType, sourceId])
}

// ============================================
// INVOICES & PAYMENTS
// ============================================

model Invoice {
  id                    String        @id @default(uuid())
  tenantId              String
  customerId            String?
  bookingId             String?
  invoiceNumber         String        @unique
  invoiceDate           DateTime      @default(now())
  dueDate               DateTime?
  subtotalSYP           Decimal       @db.Decimal(12, 2)
  subtotalUSD           Decimal?      @db.Decimal(12, 2)
  taxSYP                Decimal       @default(0) @db.Decimal(12, 2)
  taxUSD                Decimal?      @db.Decimal(12, 2)
  taxRateId             String?
  discountSYP           Decimal       @default(0) @db.Decimal(12, 2)
  discountUSD           Decimal?      @db.Decimal(12, 2)
  loyaltyPointsEarned   Int           @default(0)
  loyaltyPointsRedeemed Int           @default(0)
  totalSYP              Decimal       @db.Decimal(12, 2)
  totalUSD              Decimal?      @db.Decimal(12, 2)
  paidSYP               Decimal       @default(0) @db.Decimal(12, 2)
  paidUSD               Decimal       @default(0) @db.Decimal(12, 2)
  status                InvoiceStatus @default(DRAFT)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer?        @relation(fields: [customerId], references: [id])
  booking           Booking?         @relation(fields: [bookingId], references: [id])
  taxRate           TaxRate?         @relation(fields: [taxRateId], references: [id])
  items             InvoiceItem[]
  payments          Payment[]
  attachments       Attachment[]
  couponUsages      CouponUsage[]
  installmentPlan   InstallmentPlan? @relation(fields: [installmentPlanId], references: [id])
  installmentPlanId String?

  @@index([tenantId])
  @@index([customerId])
  @@index([bookingId])
  @@index([invoiceNumber])
  @@index([invoiceDate])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  partId      String?
  description String
  quantity    Int
  priceSYP    Decimal  @db.Decimal(12, 2)
  priceUSD    Decimal? @db.Decimal(12, 2)
  totalSYP    Decimal  @db.Decimal(12, 2)
  totalUSD    Decimal? @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  part    Part?   @relation(fields: [partId], references: [id])

  @@index([invoiceId])
  @@index([partId])
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  invoiceId     String
  amountSYP     Decimal       @db.Decimal(12, 2)
  amountUSD     Decimal?      @db.Decimal(12, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  createdAt     DateTime      @default(now())

  invoice               Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  CashRegisterSession   CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id])
  cashRegisterSessionId String?

  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentDate])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  CHECK
}

model Currency {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExchangeRate {
  id             String   @id @default(uuid())
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal  @db.Decimal(10, 6)
  effectiveDate  DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([effectiveDate])
}

// ============================================
// HR & PAYROLL
// ============================================

model Employee {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String?
  fullName     String
  phone        String
  address      String?
  departmentId String?
  position     String
  hireDate     DateTime
  salarySYP    Decimal  @db.Decimal(12, 2)
  salaryUSD    Decimal? @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department     Department?     @relation(fields: [departmentId], references: [id])
  attendance     Attendance[]
  payrollRecords PayrollRecord[]

  @@index([tenantId])
  @@index([departmentId])
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  nameAr    String?
  nameEn    String?
  managerId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@index([tenantId])
}

model Attendance {
  id          String    @id @default(uuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Decimal?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model Shift {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model PayrollRecord {
  id             String        @id @default(uuid())
  employeeId     String
  periodStart    DateTime
  periodEnd      DateTime
  basicSalarySYP Decimal       @db.Decimal(12, 2)
  basicSalaryUSD Decimal?      @db.Decimal(12, 2)
  overtimeSYP    Decimal       @default(0) @db.Decimal(12, 2)
  overtimeUSD    Decimal?      @default(0) @db.Decimal(12, 2)
  bonusesSYP     Decimal       @default(0) @db.Decimal(12, 2)
  bonusesUSD     Decimal?      @default(0) @db.Decimal(12, 2)
  deductionsSYP  Decimal       @default(0) @db.Decimal(12, 2)
  deductionsUSD  Decimal?      @default(0) @db.Decimal(12, 2)
  netSalarySYP   Decimal       @db.Decimal(12, 2)
  netSalaryUSD   Decimal?      @db.Decimal(12, 2)
  status         PayrollStatus @default(DRAFT)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

// ============================================
// SYSTEM
// ============================================

model CompanySettings {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  companyName       String
  companyNameAr     String?
  companyNameEn     String?
  logoUrl           String?
  address           String?
  phone             String?
  taxNumber         String?
  defaultCurrencyId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String?
  title     String
  titleAr   String?
  titleEn   String?
  body      String
  bodyAr    String?
  bodyEn    String?
  type      NotificationType
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_UPDATED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  INVOICE_SENT
  INVENTORY_LOW
  PAYROLL_READY
  SYSTEM
}

model WhatsAppMessage {
  id          String        @id @default(uuid())
  tenantId    String
  phoneNumber String
  message     String
  status      MessageStatus @default(PENDING)
  sentAt      DateTime?
  deliveredAt DateTime?
  error       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@index([phoneNumber])
  @@index([status])
  @@index([createdAt])
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// ============================================
// ATTACHMENTS (Images & Files)
// ============================================

model Attachment {
  id                         String                    @id @default(uuid())
  tenantId                   String
  entityType                 String // 'vehicle', 'part', 'invoice', 'booking'
  entityId                   String
  fileName                   String
  fileUrl                    String
  fileSize                   Int
  mimeType                   String
  uploadedBy                 String?
  createdAt                  DateTime                  @default(now())
  Vehicle                    Vehicle?                  @relation(fields: [vehicleId], references: [id])
  vehicleId                  String?
  Booking                    Booking?                  @relation(fields: [bookingId], references: [id])
  bookingId                  String?
  Part                       Part?                     @relation(fields: [partId], references: [id])
  partId                     String?
  Invoice                    Invoice?                  @relation(fields: [invoiceId], references: [id])
  invoiceId                  String?
  PreventiveMaintenanceLog   PreventiveMaintenanceLog? @relation(fields: [preventiveMaintenanceLogId], references: [id])
  preventiveMaintenanceLogId String?

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================
// MAINTENANCE SCHEDULES
// ============================================

model MaintenanceSchedule {
  id             String          @id @default(uuid())
  tenantId       String
  vehicleId      String
  serviceId      String
  type           MaintenanceType
  intervalKm     Int? // Every X km
  intervalMonths Int? // Every X months
  lastKm         Int?
  lastDate       DateTime?
  nextKm         Int?
  nextDate       DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  Vehicle        Vehicle         @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([nextDate])
}

enum MaintenanceType {
  OIL_CHANGE
  FILTER_CHANGE
  BRAKE_SERVICE
  TIRE_ROTATION
  BATTERY_CHECK
  GENERAL_INSPECTION
  CUSTOM
}

// ============================================
// LOYALTY PROGRAM
// ============================================

model LoyaltyPoint {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  points     Int      @default(0)
  invoiceId  String?
  reason     String? // 'purchase', 'bonus', 'redemption'
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
}

model LoyaltyReward {
  id             String     @id @default(uuid())
  tenantId       String
  name           String
  nameAr         String?
  nameEn         String?
  description    String?
  pointsRequired Int
  discountType   RewardType
  discountValue  Decimal    @db.Decimal(12, 2)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tenantId])
  @@index([pointsRequired])
}

enum RewardType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SERVICE
}

// ============================================
// TAX ENGINE
// ============================================

model TaxRate {
  id        String       @id @default(uuid())
  tenantId  String
  name      String
  rate      Decimal      @db.Decimal(5, 4) // e.g., 0.1500 for 15%
  appliesTo TaxAppliesTo
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  Invoice   Invoice[]

  @@index([tenantId])
  @@index([appliesTo])
}

enum TaxAppliesTo {
  SERVICES
  PARTS
  BOTH
}

// ============================================
// MECHANIC SHIFTS
// ============================================

model MechanicShift {
  id             String   @id @default(uuid())
  tenantId       String
  mechanicUserId String
  shiftName      String
  startTime      String // HH:MM format
  endTime        String // HH:MM format
  commissionRate Decimal  @db.Decimal(5, 4) // e.g., 0.1000 for 10%
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@index([mechanicUserId])
}

// ============================================
// ENHANCED AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  isUndo     Boolean  @default(false)
  undoOfId   String?
  createdAt  DateTime @default(now())

  user        User?      @relation(fields: [userId], references: [id])
  undoOf      AuditLog?  @relation("AuditUndo", fields: [undoOfId], references: [id])
  undoActions AuditLog[] @relation("AuditUndo")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([isUndo])
  @@index([undoOfId])
}

// ============================================
// PUSH NOTIFICATIONS (FCM)
// ============================================

model PushNotificationToken {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  token      String
  platform   String // 'ios', 'android', 'web'
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  User       User      @relation(fields: [userId], references: [id])

  @@unique([userId, token])
  @@index([tenantId])
  @@index([userId])
  @@index([platform])
}

// ============================================
// ELECTRONIC SIGNATURE
// ============================================

model ElectronicSignature {
  id            String   @id @default(uuid())
  tenantId      String
  bookingId     String   @unique
  customerId    String
  signatureData String // Base64 encoded signature
  signedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([tenantId])
  @@index([bookingId])
  @@index([customerId])
}

// ============================================
// CASH DRAWER MANAGEMENT
// ============================================

model CashRegister {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  cashierUserId String?  @unique
  balanceSYP    Decimal  @default(0) @db.Decimal(15, 2)
  balanceUSD    Decimal  @default(0) @db.Decimal(15, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cashier  User?                 @relation(fields: [cashierUserId], references: [id])
  sessions CashRegisterSession[]

  @@index([tenantId])
  @@index([cashierUserId])
}

model CashRegisterSession {
  id                String        @id @default(uuid())
  tenantId          String
  cashRegisterId    String
  cashierUserId     String?
  openingBalanceSYP Decimal       @db.Decimal(15, 2)
  openingBalanceUSD Decimal       @db.Decimal(15, 2)
  closingBalanceSYP Decimal?
  closingBalanceUSD Decimal?
  openedAt          DateTime      @default(now())
  closedAt          DateTime?
  status            SessionStatus @default(OPEN)
  notes             String?

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
  cashier      User?        @relation("CashRegisterSessionCashier", fields: [cashierUserId], references: [id])
  payments     Payment[]

  @@index([tenantId])
  @@index([cashRegisterId])
  @@index([cashierUserId])
  @@index([status])
}

enum SessionStatus {
  OPEN
  CLOSED
}

// ============================================
// PROMOTIONS & DISCOUNTS
// ============================================

model Promotion {
  id            String        @id @default(uuid())
  tenantId      String
  name          String
  nameAr        String?
  nameEn        String?
  description   String?
  couponCode    String?       @unique
  discountType  PromotionType
  discountValue Decimal       @db.Decimal(12, 2)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  conditions PromotionCondition[]
  usages     CouponUsage[]

  @@index([tenantId])
  @@index([couponCode])
  @@index([isActive])
  @@index([startDate, endDate])
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SERVICE
  FREE_PART
}

model PromotionCondition {
  id            String        @id @default(uuid())
  promotionId   String
  conditionType ConditionType
  value         String?
  createdAt     DateTime      @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
}

enum ConditionType {
  MINIMUM_AMOUNT
  CUSTOMER_TYPE
  FIRST_PURCHASE
  SPECIAL_OCCASION
  VEHICLE_TYPE
  SERVICE_TYPE
}

model CouponUsage {
  id          String   @id @default(uuid())
  promotionId String
  customerId  String
  invoiceId   String
  discountSYP Decimal  @db.Decimal(12, 2)
  discountUSD Decimal? @db.Decimal(12, 2)
  usedAt      DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id])
  Invoice   Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([promotionId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([usedAt])
}

// ============================================
// TASKS & NOTES
// ============================================

model Task {
  id          String       @id @default(uuid())
  tenantId    String
  title       String
  description String?
  priority    TaskPriority
  status      TaskStatus   @default(PENDING)
  dueDate     DateTime?
  entityType  String? // 'booking', 'customer', 'vehicle'
  entityId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignments TaskAssignment[]
  Booking     Booking?         @relation(fields: [bookingId], references: [id])
  bookingId   String?

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  @@index([entityType, entityId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TaskAssignment {
  id          String    @id @default(uuid())
  taskId      String
  userId      String
  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Note {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String // 'booking', 'customer', 'vehicle', 'part'
  entityId   String
  content    String
  createdBy  String
  isPrivate  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdBy])
}

// ============================================
// ADVANCED VEHICLE MANAGEMENT
// ============================================

model VehicleMileageLog {
  id        String      @id @default(uuid())
  tenantId  String
  vehicleId String
  km        Int
  loggedAt  DateTime    @default(now())
  loggedBy  String
  type      MileageType // 'ENTRY', 'EXIT', 'MAINTENANCE'

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([loggedAt])
}

enum MileageType {
  ENTRY
  EXIT
  MAINTENANCE
}

model VehicleIssue {
  id          String      @id @default(uuid())
  tenantId    String
  vehicleId   String
  description String
  reportedBy  String? // customer or mechanic
  reportedAt  DateTime    @default(now())
  status      IssueStatus @default(OPEN)
  resolvedAt  DateTime?
  resolvedBy  String?
  Vehicle     Vehicle     @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([status])
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model VehicleInspectionChecklist {
  id             String   @id @default(uuid())
  tenantId       String
  vehicleId      String
  bookingId      String?
  inspectionDate DateTime @default(now())
  inspectedBy    String
  brakes         Boolean
  oil            Boolean
  tires          Boolean
  battery        Boolean
  lights         Boolean
  fluids         Boolean
  notes          String?
  createdAt      DateTime @default(now())
  Vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([bookingId])
  @@index([inspectionDate])
}

// ============================================
// ADVANCED PURCHASING
// ============================================

model PurchaseOrder {
  id          String      @id @default(uuid())
  tenantId    String
  supplierId  String
  orderNumber String      @unique
  orderDate   DateTime    @default(now())
  totalSYP    Decimal     @db.Decimal(12, 2)
  totalUSD    Decimal?    @db.Decimal(12, 2)
  status      OrderStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  grns     GoodsReceiptNote[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([orderNumber])
  @@index([status])
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  partId          String
  quantity        Int
  costSYP         Decimal  @db.Decimal(12, 2)
  costUSD         Decimal? @db.Decimal(12, 2)
  totalSYP        Decimal  @db.Decimal(12, 2)
  totalUSD        Decimal? @db.Decimal(12, 2)
  receivedQty     Int      @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id])

  @@index([purchaseOrderId])
  @@index([partId])
}

model GoodsReceiptNote {
  id              String                 @id @default(uuid())
  tenantId        String
  purchaseOrderId String
  supplierId      String
  warehouseId     String?
  grnNumber       String                 @unique
  receivedDate    DateTime               @default(now())
  status          GRNStatus              @default(DRAFT)
  receivedBy      String
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  purchaseOrder PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id])
  supplier       Supplier               @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse?             @relation(fields: [warehouseId], references: [id])
  lines          GoodsReceiptNoteLine[]

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([grnNumber])
  @@index([status])
  @@index([receivedDate])
}

model GoodsReceiptNoteLine {
  id               String   @id @default(uuid())
  grnId            String
  partId           String
  orderedQuantity  Int
  receivedQuantity Int
  damagedQuantity  Int      @default(0)
  unitCost         Decimal  @db.Decimal(12, 2)
  totalCost        Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  grn  GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  part Part             @relation(fields: [partId], references: [id])

  @@index([grnId])
  @@index([partId])
}

enum GRNStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
}


// ============================================
// INSTALLMENTS
// ============================================

model InstallmentPlan {
  id               String            @id @default(uuid())
  tenantId         String
  customerId       String
  invoiceId        String
  totalAmountSYP   Decimal           @db.Decimal(12, 2)
  totalAmountUSD   Decimal?          @db.Decimal(12, 2)
  downPaymentSYP   Decimal           @db.Decimal(12, 2)
  downPaymentUSD   Decimal?          @db.Decimal(12, 2)
  numberOfPayments Int
  interestRate     Decimal           @db.Decimal(5, 4)
  paymentFrequency PaymentFrequency
  startDate        DateTime
  status           InstallmentStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  installments Installment[]
  Invoice      Invoice[]

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
}

enum PaymentFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
  QUARTERLY
}

enum InstallmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DEFAULTED
}

model Installment {
  id                String                   @id @default(uuid())
  installmentPlanId String
  sequenceNumber    Int
  dueDate           DateTime
  amountSYP         Decimal                  @db.Decimal(12, 2)
  amountUSD         Decimal?                 @db.Decimal(12, 2)
  paidSYP           Decimal                  @default(0) @db.Decimal(12, 2)
  paidUSD           Decimal                  @default(0) @db.Decimal(12, 2)
  status            InstallmentPaymentStatus @default(PENDING)
  paidAt            DateTime?
  reminderSentAt    DateTime?

  installmentPlan InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)

  @@index([installmentPlanId])
  @@index([dueDate])
  @@index([status])
}

enum InstallmentPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ============================================
// REVIEWS & RATINGS
// ============================================

model Review {
  id         String   @id @default(uuid())
  tenantId   String
  bookingId  String
  customerId String
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  Booking    Booking  @relation(fields: [bookingId], references: [id])

  @@index([tenantId])
  @@index([bookingId])
  @@index([customerId])
  @@index([rating])
}

model MechanicRating {
  id             String   @id @default(uuid())
  tenantId       String
  mechanicUserId String
  bookingId      String
  rating         Int // 1-5
  comment        String?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([mechanicUserId])
  @@index([bookingId])
  @@index([rating])
}

// ============================================
// TIME SLOTS & APPOINTMENTS
// ============================================

model TimeSlot {
  id        String   @id @default(uuid())
  tenantId  String
  dayOfWeek Int // 0-6 (Sunday-Saturday)
  startTime String // HH:MM format
  endTime   String // HH:MM format
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([dayOfWeek])
}

model AppointmentLog {
  id              String            @id @default(uuid())
  tenantId        String
  bookingId       String            @unique
  scheduledAt     DateTime
  actualStart     DateTime?
  actualEnd       DateTime?
  status          AppointmentStatus
  rescheduledFrom DateTime?
  rescheduledTo   DateTime?
  reminderSent    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([tenantId])
  @@index([bookingId])
  @@index([scheduledAt])
  @@index([status])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

// ============================================
// WARRANTY
// ============================================

model Warranty {
  id             String       @id @default(uuid())
  tenantId       String
  entityType     String // 'service' or 'part'
  entityId       String
  warrantyType   WarrantyType
  durationMonths Int?
  durationKm     Int?
  startDate      DateTime     @default(now())
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  claims WarrantyClaim[]

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([isActive])
  @@index([endDate])
}

enum WarrantyType {
  SERVICE
  PART
  BOTH
}

model WarrantyClaim {
  id             String              @id @default(uuid())
  tenantId       String
  warrantyId     String
  bookingId      String
  description    String
  status         WarrantyClaimStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  warranty Warranty @relation(fields: [warrantyId], references: [id])

  @@index([tenantId])
  @@index([warrantyId])
  @@index([bookingId])
  @@index([status])
}

enum WarrantyClaimStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ============================================
// EXTRA CHARGES
// ============================================

model ExtraChargeType {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  nameAr           String?
  nameEn           String?
  description      String?
  priceSYP         Decimal  @db.Decimal(12, 2)
  priceUSD         Decimal? @db.Decimal(12, 2)
  requiresApproval Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookingExtraCharges BookingExtraCharge[]

  @@index([tenantId])
  @@index([isActive])
}

model BookingExtraCharge {
  id                String    @id @default(uuid())
  tenantId          String
  bookingId         String
  extraChargeTypeId String
  priceSYP          Decimal   @db.Decimal(12, 2)
  priceUSD          Decimal?  @db.Decimal(12, 2)
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())

  booking         Booking         @relation(fields: [bookingId], references: [id])
  extraChargeType ExtraChargeType @relation(fields: [extraChargeTypeId], references: [id])

  @@index([tenantId])
  @@index([bookingId])
  @@index([extraChargeTypeId])
}

// ============================================
// PREVENTIVE MAINTENANCE
// ============================================

model PreventiveMaintenanceTemplate {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  nameAr         String?
  nameEn         String?
  description    String?
  intervalKm     Int // e.g., 10000 km
  intervalMonths Int? // e.g., 6 months
  priorityKm     Int // e.g., 1000 km before
  priorityMonths Int? // e.g., 1 month before
  maxDelayKm     Int? // e.g., 1000 km after
  maxDelayMonths Int? // e.g., 1 month after
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs     PreventiveMaintenanceLog[]
  packages MaintenancePackage[]

  @@index([tenantId])
  @@index([isActive])
}

model PreventiveMaintenanceLog {
  id            String            @id @default(uuid())
  tenantId      String
  templateId    String
  vehicleId     String
  scheduledKm   Int
  scheduledDate DateTime
  actualKm      Int?
  actualDate    DateTime?
  status        MaintenanceStatus @default(SCHEDULED)
  isDelayed     Boolean           @default(false)
  delayReason   String?
  attachments   Attachment[]
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  template PreventiveMaintenanceTemplate @relation(fields: [templateId], references: [id])
  vehicle  Vehicle                       @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([templateId])
  @@index([vehicleId])
  @@index([scheduledDate])
  @@index([status])
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

model MaintenancePackage {
  id          String   @id @default(uuid())
  tenantId    String
  templateId  String
  name        String
  nameAr      String?
  nameEn      String?
  description String?
  totalSYP    Decimal  @db.Decimal(12, 2)
  totalUSD    Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template PreventiveMaintenanceTemplate @relation(fields: [templateId], references: [id])
  items    MaintenancePackageItem[]

  @@index([tenantId])
  @@index([templateId])
  @@index([isActive])
}

model MaintenancePackageItem {
  id        String   @id @default(uuid())
  packageId String
  partId    String?
  serviceId String?
  quantity  Int
  priceSYP  Decimal  @db.Decimal(12, 2)
  priceUSD  Decimal? @db.Decimal(12, 2)

  package MaintenancePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  part    Part?              @relation(fields: [partId], references: [id])
  service Service?           @relation(fields: [serviceId], references: [id])

  @@index([packageId])
  @@index([partId])
  @@index([serviceId])
}

// ============================================
// CHEQUE MANAGEMENT
// ============================================

model Cheque {
  id            String       @id @default(uuid())
  tenantId      String
  chequeNumber  String
  bankName      String
  branchName    String?
  amountSYP     Decimal      @db.Decimal(15, 2)
  amountUSD     Decimal?     @db.Decimal(15, 2)
  chequeDate    DateTime
  dueDate       DateTime
  type          ChequeType
  status        ChequeStatus @default(PENDING)
  issuerName    String? // من أصدر الشيك
  receiverName  String? // من يستلم الشيك
  invoiceId     String? // مرتبط بفاتورة
  notes         String?
  bouncedAt     DateTime?
  bouncedReason String?
  clearedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  transactions ChequeTransaction[]

  @@index([tenantId])
  @@index([chequeNumber])
  @@index([dueDate])
  @@index([status])
  @@index([type])
  @@index([invoiceId])
}

enum ChequeType {
  OUTGOING // صادرة - نعطيها للمورد
  INCOMING // واردة - نستلمها من الزبون
}

enum ChequeStatus {
  PENDING // تحت التحصيل/الدفع
  DEPOSITED // مودعة في البنك
  CLEARED // محصلة/مقبوضة
  BOUNCED // مرتجعة
  CANCELLED // ملغاة
  DELAYED // مؤجلة
}

model ChequeTransaction {
  id              String                @id @default(uuid())
  tenantId        String
  chequeId        String
  transactionType ChequeTransactionType
  amountSYP       Decimal               @db.Decimal(15, 2)
  amountUSD       Decimal?              @db.Decimal(15, 2)
  transactionDate DateTime              @default(now())
  description     String?
  bankFeeSYP      Decimal               @default(0) @db.Decimal(12, 2)
  bankFeeUSD      Decimal?              @db.Decimal(12, 2)
  reference       String?
  createdAt       DateTime              @default(now())

  cheque Cheque @relation(fields: [chequeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([chequeId])
  @@index([transactionDate])
  @@index([transactionType])
}

enum ChequeTransactionType {
  DEPOSIT // إيداع
  WITHDRAWAL // سحب
  TRANSFER // تحويل
  BOUNCE_FEE // رسوم مرتجع
  CLEARANCE // قبض
}

// ============================================
// INVENTORY COUNTING
// ============================================

model InventoryCount {
  id            String      @id @default(uuid())
  tenantId      String
  countNumber   String      @unique
  countType     CountType
  warehouseId   String?
  scheduledDate DateTime
  actualDate    DateTime?
  status        CountStatus @default(SCHEDULED)
  countedBy     String?
  approvedBy    String?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items       InventoryCountItem[]
  adjustments InventoryCountAdjustment[]

  @@index([tenantId])
  @@index([countNumber])
  @@index([scheduledDate])
  @@index([status])
}

enum CountType {
  REGULAR // دوري
  SURPRISE // مفاجئ
  PARTIAL // جزئي
  FULL // شامل
}

enum CountStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  APPROVED
  CANCELLED
}

model InventoryCountItem {
  id          String   @id @default(uuid())
  countId     String
  partId      String
  expectedQty Int
  actualQty   Int
  varianceQty Int
  unitCostSYP Decimal  @db.Decimal(12, 2)
  unitCostUSD Decimal? @db.Decimal(12, 2)
  varianceSYP Decimal  @db.Decimal(15, 2)
  varianceUSD Decimal? @db.Decimal(15, 2)
  notes       String?

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  part  Part           @relation(fields: [partId], references: [id])

  @@index([countId])
  @@index([partId])
}

model InventoryCountAdjustment {
  id             String         @id @default(uuid())
  tenantId       String
  countId        String
  partId         String
  adjustmentType AdjustmentType
  quantity       Int
  costSYP        Decimal        @db.Decimal(12, 2)
  costUSD        Decimal?       @db.Decimal(12, 2)
  reason         String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([countId])
  @@index([partId])
}

enum AdjustmentType {
  INCREASE
  DECREASE
}
