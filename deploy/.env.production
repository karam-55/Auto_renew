# ============================================
# AUTO_REnew - Production Environment Template
# ============================================
# Fill in ALL values marked <REQUIRED> before deployment
# Generate strong secrets: openssl rand -base64 32
# ============================================

# ============================================
# PostgreSQL (Main Database)
# ============================================
POSTGRES_USER=garage_admin
POSTGRES_PASSWORD=<REQUIRED: generate strong password>
POSTGRES_DB=garage_master

# ============================================
# Redis
# ============================================
REDIS_PASSWORD=<REQUIRED: generate strong password>

# ============================================
# MinIO
# ============================================
MINIO_ROOT_USER=garage_minio
MINIO_ROOT_PASSWORD=<REQUIRED: generate strong password>
MINIO_BUCKET=garage-files

# ============================================
# JWT Secrets (32+ characters)
# Generate: openssl rand -base64 32
# ============================================
JWT_SECRET=<REQUIRED: 32+ character secret>
JWT_REFRESH_SECRET=<REQUIRED: 32+ character secret>

# ============================================
# CORS Origins (update with your actual IP/domain)
# ============================================
CORS_ORIGIN=*
CUSTOMER_CORS_ORIGIN=*
MECHANIC_CORS_ORIGIN=*

# ============================================
# Multi-tenancy
# ============================================
DEFAULT_TENANT_ID=default

# ============================================
# Server IP (for documentation)
# ============================================
SERVER_IP=<YOUR_HETZNER_IP>

# ============================================
# WhatsApp (WhatChimp)
# ============================================
WATCHIMP_ENABLED=true
WATCHIMP_API_KEY=<REQUIRED: WhatChimp API key>
WATCHIMP_API_URL=https://app.whatchimp.com/api/v1
WATCHIMP_PHONE_NUMBER_ID=<REQUIRED: WhatsApp phone number ID>
WATCHIMP_BUSINESS_ACCOUNT_ID=<REQUIRED: WhatsApp Business Account ID>

# ============================================
# WhatsApp (Meta Cloud API fallback)
# ============================================
META_WHATSAPP_ENABLED=true
META_WHATSAPP_ACCESS_TOKEN=<REQUIRED: Meta access token>
META_WHATSAPP_PHONE_NUMBER_ID=<REQUIRED: WhatsApp phone number ID>
META_WHATSAPP_BUSINESS_ACCOUNT_ID=<REQUIRED: WhatsApp Business Account ID>
META_WHATSAPP_API_VERSION=v18.0

BASE_URL=http://<YOUR_HETZNER_IP>
